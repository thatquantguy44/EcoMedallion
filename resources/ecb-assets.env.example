# Install as /etc/fred-pipeline/ecb-assets.env with mode 0600.
# Values here are examples only; never commit production credentials.
PYTHONUNBUFFERED=1
FRED_CONFIG_FILE=/etc/fred-pipeline/config.yaml
FRED_WAREHOUSE_CONFIG=/etc/fred-pipeline/warehouse.yml
FRED_ECB_ASSETS_AUTHORITATIVE_BACKEND=postgres
FRED_ALERTING_FILE=/etc/fred-pipeline/alerting.yml
FRED_POSTGRES_SERVICE_DSN=REPLACE_WITH_SECRET_POSTGRES_DSN

# Set only the credential required by the selected alert transport.
# FRED_GRAPH_CLIENT_SECRET=REPLACE_WITH_SECRET
# FRED_SMTP_PASSWORD=REPLACE_WITH_SECRET
