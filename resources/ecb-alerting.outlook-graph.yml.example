# ECB production alerting through Outlook/Microsoft 365 using Microsoft Graph.
#
# Register an Entra application with Mail.Send application permission and admin
# consent. Put its client secret in FRED_GRAPH_CLIENT_SECRET on the scheduler
# host; never store it here. The sender must be a real tenant mailbox.
enabled: true
policy: failure
from_address: REPLACE_WITH_SENDER@example.com
from_name: ECB Eligible Assets Pipeline
subject_prefix: "[FRED]"
environments: [prod]
attach_run_json: true
max_failures_listed: 25

ecb_assets:
  enabled: true
  expected_release_time_local: "18:15"
  grace_period_minutes: 180
  max_change_percent: 20.0
  alert_on_gap: true
  alert_on_quarantine: true

transport:
  kind: microsoft_graph
  tenant_id: REPLACE_WITH_ENTRA_TENANT_ID
  client_id: REPLACE_WITH_ENTRA_CLIENT_ID
  client_secret_env: FRED_GRAPH_CLIENT_SECRET
  timeout_seconds: 30

routes:
  failure:
    to: [REPLACE_WITH_ONCALL@example.com]
  partial:
    to: [REPLACE_WITH_ONCALL@example.com]
